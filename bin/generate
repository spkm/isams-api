#!/usr/bin/env php
<?php

use spkm\IsamsApi\Generator\Generator;
use spkm\IsamsApi\Generator\Writer;

require __DIR__.'/../vendor/autoload.php';

$root = dirname(__DIR__);
$files = (new Generator($root))->build();
$writer = new Writer($root);

if (in_array('--check', $_SERVER['argv'] ?? [], true)) {
    $plan = $writer->plan($files);
    $stale = [...$plan['changed'], ...$plan['removed']];

    if ($stale === []) {
        echo "Generated code is up to date.\n";
        exit(0);
    }

    echo "Generated code is out of date; run composer generate.\n";

    foreach ($stale as $path) {
        echo "  $path\n";
    }

    exit(1);
}

$plan = $writer->write($files);
printf("Built %d files: %d written, %d removed.\n", count($files), count($plan['changed']), count($plan['removed']));
