{
    "name": "spkm/isams-api",
    "description": "Integrate with the iSAMS API using SaloonPHP",
    "license": "MIT",
    "keywords": [
        "iSAMS",
        "REST API",
        "Laravel"
    ],
    "authors": [
        {
            "name": "Simon Mitchell",
            "email": "hello@spkmitchell.co.uk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "saloonphp/saloon": "^4.0",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/cache-plugin": "^3.0",
        "saloonphp/pagination-plugin": "^2.0",
        "illuminate/contracts": "^12.39||^13.0",
        "illuminate/support": "^12.39||^13.0",
        "illuminate/cache": "^12.39||^13.0",
        "illuminate/collections": "^12.39||^13.0",
        "spatie/laravel-package-tools": "^1.19"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.20",
        "mockery/mockery": "^1.6",
        "nette/php-generator": "^4.1",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0",
        "symfony/var-dumper": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "spkm\\IsamsApi\\": [
                "src/",
                "generated/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "spkm\\IsamsApi\\Tests\\": "tests/",
            "spkm\\IsamsApi\\Generator\\": "generator/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "spkm\\IsamsApi\\IsamsApiServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@hooks"
        ],
        "post-update-cmd": [
            "@hooks"
        ],
        "hooks": "php -r \"is_dir('.git') && exec('git config core.hooksPath .githooks');\"",
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "generate": "@php bin/generate",
        "generate:check": "@php bin/generate --check"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
